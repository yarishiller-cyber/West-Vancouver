# .htaccess — Hostinger (Apache/LiteSpeed). FLEET §0 clean URLs + HTTPS + canonical
# www host, gzip, caching, security headers, protect internals.
Options +FollowSymLinks -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS 301 (direct or behind a proxy/CDN) + canonical host www.northshoregaragedoors.ca
  # (also catches the old westvangaragedoors.ca domain and any non-www variant)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{HTTP_HOST} !^www\.northshoregaragedoors\.ca$ [NC]
  RewriteRule ^ https://www.northshoregaragedoors.ca%{REQUEST_URI} [L,R=301]

  # --- Legacy URL 301 redirects (old filenames Google still has indexed -> live clean URLs) ---
  RewriteRule ^garage-doors\.html$   /new-garage-doors/    [R=301,L]
  RewriteRule ^springs\.html$        /spring-repair/       [R=301,L]
  RewriteRule ^openers\.html$        /opener-installation/ [R=301,L]
  RewriteRule ^reviews\.html$        /#reviews             [R=301,L,NE]
  RewriteRule ^contact\.html$        /#contact             [R=301,L,NE]
  RewriteRule ^about\.html$          /#about               [R=301,L,NE]
  RewriteRule ^faq\.html$            /#faq                 [R=301,L,NE]

  # strip index.html (root or subdir) -> directory
  RewriteCond %{THE_REQUEST} \s/+(([^?\s]*/)?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /page.html -> /page/   (301; consolidates old links)
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1/ [R=301,L]

  # serve /page/ AND nested /dir/page/ from the flat .html file
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+?)/?$ $1.html [L]

  RewriteRule ^(_build|_shared)/ - [F,L]
</IfModule>

# Protect internal / markdown / config files
<FilesMatch "\.(md|mjs|sh|py|gitmodules)$">
  Require all denied
</FilesMatch>
<Files "site-config.json">
  Require all denied
</Files>
<Files "site.webmanifest">
  Require all granted
</Files>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/svg+xml     "access plus 1 year"
  ExpiresByType text/css          "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html         "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), browsing-topics=()"
  # HSTS (1 year). No preload/includeSubDomains so it stays reversible.
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  # Long-cache fingerprint-free static assets; HTML stays fresh (set above).
  <FilesMatch "\.(webp|png|svg|jpg|jpeg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Correct MIME + compression for modern types
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/manifest+json text/plain
</IfModule>

ErrorDocument 404 /404.html
